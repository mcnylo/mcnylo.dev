@{
    ViewData["Title"] = "Home";
}

<!-- Banner Hero Video -->
<section class="relative flex min-h-[50vh] w-full items-center overflow-hidden">
    <video class="absolute inset-0 h-full w-full object-cover"
           autoplay
           muted
           loop
           playsinline
           poster="~/images/placeholder_banner_poster.jpg">
        <source src="~/videos/placeholder_banner_hero.mp4" type="video/mp4" />
        Your browser does not support the video tag (.mp4)
    </video>



    <div class="relative z-10 mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="max-w-3xl">

            <!-- Text options maintained on wwwroot/home.js -->
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-primary text-violet-300 text-neon-blue">
                // 
                <span id="typewriter-text"></span>
                <span class="animate-pulse">|</span>
            </p>

            <h1 class="text-4xl font-bold leading-tight text-white sm:text-6xl lg:text-7xl">
                Michael McNiel
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/75">
                Software developer building reliable software, improving complex systems, and exploring how technology works beneath the surface.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
                <a asp-controller="Projects" asp-action="Index" class="btn btn-primary">
                    View Projects
                </a>

                <a asp-controller="About" asp-action="Index" class="btn btn-outline text-white hover:text-base-content">
                    About Me
                </a>
            </div>

        </div>
    </div>
</section>

<!-- Short About Me Section -->
<section class="bg-base-300 px-4 py-20 sm:px-6 lg:px-8">
    <div class="about-preview-grid mx-auto max-w-6xl">
        <div>
            <p class="text-neon-blue text-sm font-semibold uppercase tracking-[0.35em]">
                // Summary
            </p>

            <h2 class="mt-4 text-3xl font-bold text-base-content sm:text-4xl">
                C#, C/C++, SQL, Python, Java, Assembly...

                <br />
                <br />

                Whatever. It's all just basic* programming!
            </h2>

            <br />

            <p class="mt-10 text-lg font-bold text-base-content">
                * Well... sometimes.
            </p>
        </div>

        <div class="about-preview-right">
            <div class="about-preview-stack">

                <div class="tech-logo-strip">
                    <div class="tech-logo-track">
                        <div class="tech-logo-group">
                            <img src="~/images/csharp_logo.png" alt="C#" class="tech-logo" />
                            <img src="~/images/dotnet_logo.png" alt=".NET" class="tech-logo" />
                            <img src="~/images/sqlserver_logo.png" alt="SQL Server" class="tech-logo" />
                            <img src="~/images/c_logo.png" alt="C" class="tech-logo" />
                            <img src="~/images/cpp_logo.png" alt="C++" class="tech-logo" />
                            <img src="~/images/java_logo.png" alt="Java" class="tech-logo" />
                            <img src="~/images/azure_logo.png" alt="Azure" class="tech-logo" />
                            <img src="~/images/assembly_logo.png" alt="Assembly" class="tech-logo" />
                            <img src="~/images/mysql_logo.png" alt="MySQL" class="tech-logo" />
                            <img src="~/images/python_logo.png" alt="Python" class="tech-logo" />
                            <img src="~/images/riscv_logo.png" alt="RISC-V" class="tech-logo" />
                        </div>

                        <div class="tech-logo-group" aria-hidden="true">
                            <img src="~/images/csharp_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/dotnet_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/sqlserver_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/c_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/cpp_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/java_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/azure_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/assembly_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/mysql_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/python_logo.png" alt="" class="tech-logo" />
                            <img src="~/images/riscv_logo.png" alt="" class="tech-logo" />
                        </div>
                    </div>
                </div>

                <div class="card card-glass border border-white/15">
                    <div class="card-body">
                        <p class="text-base leading-8 text-base-content/75">
                            I'm a current software developer focused on maintaining and creating production ready solutions using C#, .NET, and SQL Server.
                            Currently interested in exploring real-time systems programming (graphics, physics, simulation, etc.) using C/C++.
                            I also like to explore the hardware aspect of technology from modding old game consoles to building my own home lab and everything in between!
                        </p>

                        <div class="card-actions mt-6">
                            <a asp-controller="About" asp-action="Index" class="btn btn-primary">
                                Learn More About Me
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
    </div>
</section>

<!-- Featured Projects Section -->
<section class="bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
        <div class="mb-10 text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-neon-blue">
                // Featured Work
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
                Favorite Projects
            </h2>

            <p class="mx-auto mt-4 max-w-2xl text-base text-white/60">
                A few hand picked projects that I want to highlight as my favorites.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">

            <article class="card card-glass card-neon-blue min-h-80 border">
                <div class="card-body">
                    <div class="mb-3 flex items-center justify-between gap-3">
                        <span class="badge badge-primary badge-outline">ASP.NET Core</span>
                        <span class="text-sm text-white/40">2026</span>
                    </div>

                    <h3 class="card-title text-2xl text-white">
                        Portfolio Website
                    </h3>

                    <p class="text-white/65">
                        A personal developer portfolio built with ASP.NET Core MVC, Tailwind, daisyUI, and MySQL.
                    </p>

                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="badge badge-ghost">C#</span>
                        <span class="badge badge-ghost">MVC</span>
                        <span class="badge badge-ghost">Tailwind</span>
                        <span class="badge badge-ghost">C#</span>
                        <span class="badge badge-ghost">MVC</span>
                    </div>

                    <div class="card-actions mt-auto justify-end pt-6">
                        <a class="btn btn-sm btn-primary">View Project</a>
                    </div>
                </div>
            </article>

        </div>
    </div>
</section>

<!-- Get In Touch Section -->
<section class="bg-base-300 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-neon-blue">
            // Contact
        </p>

        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
            Want to discuss more?
        </h2>

        <div class="mt-8">
            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                Get in Touch
            </a>
        </div>
    </div>
</section>

<script src="~/js/home.js" asp-append-version="true"></script>