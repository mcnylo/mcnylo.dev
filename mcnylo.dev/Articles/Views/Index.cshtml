@model mcnylo.dev.Articles.ViewModels.ArticleIndexVM

@{
    ViewData["Title"] = "Articles";
}

<div class="archive-surface bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
        <header class="mb-10 text-center">
            <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                // Articles
            </p>

            <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                Article Archive
            </h1>

            <p class="mx-auto mt-4 max-w-2xl text-base text-white/60">
                Search by article name, category, or tag.
            </p>
        </header>

        <form method="get" action="/articles" class="mt-10 border border-[#22ee29]/15 bg-black/25 p-4">

            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.Results.PageSize" />

            <label for="search" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                Search articles
            </label>

            <div class="mt-3 grid gap-3 lg:grid-cols-[16rem_16rem_minmax(0,1fr)_auto_auto]">

                <details class="project-filter-dropdown article-category-dropdown relative">
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-xs uppercase tracking-[0.14em] text-zinc-300 transition hover:border-[#22ee29]/40">
                        
                        <span id="selected-article-category-count">
                            @if (Model.SelectedCategorySlugs.Count == 0)
                            {
                                <span>Select categories</span>
                            }
                            else if (Model.SelectedCategorySlugs.Count == 1)
                            {
                                <span>1 category selected</span>
                            }
                            else
                            {
                                <span>@Model.SelectedCategorySlugs.Count categories selected</span>
                            }
                        </span>

                        <span class="text-[#6ef967]/70">▾</span>
                    </summary>

                    <div class="about-scrollbar absolute z-50 mt-2 max-h-72 w-full overflow-y-auto border border-[#22ee29]/20 bg-zinc-950 p-3 shadow-xl shadow-black/40">
                        @if (Model.Categories.Count == 0)
                        {
                            <p class="px-2 py-2 font-mono text-xs uppercase tracking-[0.14em] text-zinc-500">
                                No categories
                            </p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var category in Model.Categories)
                                {
                                    <label class="flex cursor-pointer items-center gap-3 border border-transparent px-2 py-1.5 font-mono text-xs uppercase tracking-[0.12em] text-zinc-400 transition hover:border-[#22ee29]/15 hover:bg-[#22ee29]/[0.04] hover:text-zinc-200">
                                        <input type="checkbox"
                                               name="categorySlugs"
                                               value="@category.CategorySlug"
                                               checked="@Model.SelectedCategorySlugs.Contains(category.CategorySlug)"
                                               class="checkbox checkbox-primary checkbox-xs rounded-none" />

                                        <span>@category.CategoryName</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </details>

                <details class="project-filter-dropdown article-tag-dropdown relative">
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-xs uppercase tracking-[0.14em] text-zinc-300 transition hover:border-[#22ee29]/40">
                        <span id="selected-article-tag-count">
                            @if (Model.SelectedTagSlugs.Count == 0)
                            {
                                <span>Select tags</span>
                            }
                            else
                            {
                                <span>@Model.SelectedTagSlugs.Count selected</span>
                            }
                        </span>

                        <span class="text-[#6ef967]/70">▾</span>
                    </summary>

                    <div class="about-scrollbar absolute z-50 mt-2 max-h-72 w-full overflow-y-auto border border-[#22ee29]/20 bg-zinc-950 p-3 shadow-xl shadow-black/40">
                        @if (Model.AvailableTags.Count == 0)
                        {
                            <p class="px-2 py-2 font-mono text-xs uppercase tracking-[0.14em] text-zinc-500">
                                No tags
                            </p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var tag in Model.AvailableTags)
                                {
                                    <label class="flex cursor-pointer items-center gap-3 border border-transparent px-2 py-1.5 font-mono text-xs uppercase tracking-[0.12em] text-zinc-400 transition hover:border-[#22ee29]/15 hover:bg-[#22ee29]/[0.04] hover:text-zinc-200">
                                        <input type="checkbox"
                                               name="tagSlugs"
                                               value="@tag.TagSlug"
                                               checked="@Model.SelectedTagSlugs.Contains(tag.TagSlug)"
                                               class="checkbox checkbox-primary checkbox-xs rounded-none" />

                                        <span>@tag.TagName</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </details>

                <input id="search"
                       name="search"
                       value="@Model.Search"
                       type="search"
                       placeholder="Search by title..."
                       class="min-h-11 border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />

                <button type="submit" class="min-h-11 border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.SelectedCategorySlugs.Count > 0 || Model.SelectedTagSlugs.Count > 0)
                {
                    <a href="/articles"
                       class="inline-flex min-h-11 items-center justify-center border border-zinc-700/80 px-5 font-mono text-xs uppercase tracking-[0.18em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                        Clear
                    </a>
                }
            </div>
        </form>

        <div class="mt-12 border-t border-[#22ee29]/15">
            @if (Model.Results.Articles.Count == 0)
            {
                <div class="py-12">
                    <p class="font-mono text-sm uppercase tracking-[0.2em] text-zinc-500">
                        No published articles found.
                    </p>
                </div>
            }
            else
            {
                <div class="divide-y divide-emerald-400/10">
                    @foreach (var article in Model.Results.Articles)
                    {
                        <article class="group py-8">
                            <a href="/articles/@article.ArticleSlug"
                               class="grid gap-5 sm:grid-cols-[12rem_minmax(0,1fr)]">
                                <div class="relative overflow-hidden border border-[#22ee29]/15 bg-black/35">
                                    <img src="@article.PrimaryImagePath"
                                         alt="@article.PrimaryImageAltText"
                                         class="aspect-[16/10] h-full w-full object-cover opacity-80 grayscale transition duration-300 group-hover:scale-[1.03] group-hover:opacity-95 group-hover:grayscale-0" />

                                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-emerald-400/10 via-transparent to-black/30"></div>
                                </div>

                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-3">
                                        <p class="font-mono text-xs uppercase tracking-[0.2em] text-emerald-400/55">
                                            @(string.IsNullOrWhiteSpace(article.CategoryName) ? "Article" : article.CategoryName)
                                        </p>

                                        @if (article.Tags.Count > 0)
                                        {
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var tag in article.Tags)
                                                {
                                                    <span class="border border-[#22ee29]/15 bg-emerald-400/[0.025] px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[#6ef967]/60">
                                                        @tag.TagName
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                        <h2 class="text-2xl font-semibold tracking-tight text-zinc-100 transition-colors group-hover:text-[#6ef967]">
                                            @article.ArticleTitle
                                        </h2>

                                        @if (article.PublishedOn.HasValue)
                                        {
                                            <p class="shrink-0 font-mono text-xs uppercase tracking-[0.18em] text-zinc-500">
                                                @article.PublishedOn.Value.ToString("MMM dd, yyyy")
                                            </p>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(article.ShortDescription))
                                    {
                                        <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">
                                            @article.ShortDescription
                                        </p>
                                    }
                                </div>
                            </a>
                        </article>
                    }
                </div>

                @if (Model.Results.TotalPages > 1)
                {
                    <nav class="mt-10 flex flex-col gap-3 border-t border-[#22ee29]/15 pt-6 sm:flex-row sm:items-center sm:justify-between"
                         aria-label="Article pagination">
                        <p class="font-mono text-xs uppercase tracking-[0.18em] text-zinc-500">
                            Page @Model.Results.PageNumber of @Model.Results.TotalPages
                        </p>

                        <div class="flex flex-wrap gap-2">
                            @if (Model.Results.PageNumber > 1)
                            {
                                <a href="@BuildArticlePageUrl(Model.Results.PageNumber - 1)"
                                   class="inline-flex min-h-10 items-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                                    Prev
                                </a>
                            }

                            @for (var pageIndex = 1; pageIndex <= Model.Results.TotalPages; pageIndex++)
                            {
                                <a href="@BuildArticlePageUrl(pageIndex)"
                                   class="inline-flex min-h-10 min-w-10 items-center justify-center border px-3 font-mono text-xs uppercase tracking-[0.16em] transition @(pageIndex == Model.Results.PageNumber ? "border-[#22ee29]/60 bg-[#22ee29]/[0.08] text-[#6ef967]" : "border-zinc-700/80 text-zinc-400 hover:border-[#22ee29]/35 hover:text-zinc-200")">
                                    @pageIndex
                                </a>
                            }

                            @if (Model.Results.PageNumber < Model.Results.TotalPages)
                            {
                                <a href="@BuildArticlePageUrl(Model.Results.PageNumber + 1)"
                                   class="inline-flex min-h-10 items-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                                    Next
                                </a>
                            }
                        </div>
                    </nav>
                }
            }
        </div>
    </section>
</div>

<script>
    function updateArticleFilterCount(checkboxSelector, labelId, defaultText, singleText, pluralText) {
        const label = document.getElementById(labelId);

        if (!label) {
            return;
        }

        const checkedCount = document.querySelectorAll(`${checkboxSelector}:checked`).length;

        if (checkedCount === 0) {
            label.textContent = defaultText;
            return;
        }

        if (checkedCount === 1) {
            label.textContent = singleText;
            return;
        }

        label.textContent = `${checkedCount} ${pluralText}`;
    }

    function updateAllArticleFilterCounts() {
        updateArticleFilterCount(
            "input[name='categorySlugs']",
            "selected-article-category-count",
            "Select categories",
            "1 category selected",
            "categories selected"
        );

        updateArticleFilterCount(
            "input[name='tagSlugs']",
            "selected-article-tag-count",
            "Select tags",
            "1 tag selected",
            "tags selected"
        );
    }

    document
        .querySelectorAll("input[name='categorySlugs'], input[name='tagSlugs']")
        .forEach(function(checkbox) {
            checkbox.addEventListener("change", updateAllArticleFilterCounts);
        });

    document.addEventListener("click", function(event) {
        document
            .querySelectorAll(".article-tag-dropdown[open], .article-category-dropdown[open]")
            .forEach(function(dropdown) {
                if (!dropdown.contains(event.target)) {
                    dropdown.removeAttribute("open");
                }
            });
    });

    document.addEventListener("keydown", function(event) {
        if (event.key !== "Escape") {
            return;
        }

        document
            .querySelectorAll(".article-tag-dropdown[open], .article-category-dropdown[open]")
            .forEach(function(dropdown) {
                dropdown.removeAttribute("open");
            });
    });

    updateAllArticleFilterCounts();
</script>

@functions {
    private string BuildArticlePageUrl(int pageNumber)
    {
        var queryValues = new List<string>
        {
            $"pageNumber={pageNumber}",
            $"pageSize={Model.Results.PageSize}"
        };

        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            queryValues.Add($"search={Uri.EscapeDataString(Model.Search)}");
        }

        foreach (var categorySlug in Model.SelectedCategorySlugs)
        {
            queryValues.Add($"categorySlugs={Uri.EscapeDataString(categorySlug)}");
        }

        foreach (var tagSlug in Model.SelectedTagSlugs)
        {
            queryValues.Add($"tagSlugs={Uri.EscapeDataString(tagSlug)}");
        }

        return $"/articles?{string.Join("&", queryValues)}";
    }
}