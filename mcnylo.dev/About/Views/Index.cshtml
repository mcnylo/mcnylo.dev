@model mcnylo.dev.About.ViewModels.AboutPageVM

@{
    ViewData["Title"] = "About Me";
    ViewData["UseFixedViewport"] = true;
}

<section class="tech-surface scroll-smooth bg-base-200 lg:h-full lg:overflow-hidden">
    <div class="relative isolate mx-auto grid max-w-[1600px] lg:h-full lg:grid-cols-[minmax(18rem,34%)_minmax(0,1fr)]">

        <!-- Left navigation panel -->
        <aside class="about-profile-panel about-scrollbar relative z-10 overflow-visible px-6 py-8 lg:h-full lg:px-10">

            <div class="about-profile-stack">

                <div class="about-portrait-stage hidden lg:block" aria-hidden="true">
                    <img src="~/images/about-1-resized.png" alt="" class="about-portrait is-active" />

                    <img src="~/images/about-2-resized.png" alt="" class="about-portrait" />

                    <img src="~/images/about-3-resized.png" alt="" class="about-portrait" />

                    <img src="~/images/about-4-resized.png" alt="" class="about-portrait" />

                    <img src="~/images/about-5-resized.png" alt="" class="about-portrait" />
                </div>

                <div class="about-profile-content">

                    <div class="about-profile-copy">
                        <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                            // About Me
                        </p>

                        <h1 class="mt-4 text-4xl font-bold text-white">
                            @Model.DisplayName
                        </h1>

                        <p class="mt-4 max-w-md leading-7 text-white/60">
                            @Model.ProfileSummary
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.ResumePdfUrl))
                        {
                            <a href="@Model.ResumePdfUrl"
                               target="_blank"
                               rel="noopener"
                               class="mt-6 inline-flex items-center gap-2 border border-green-500/70 bg-green-500/10 px-4 py-2 text-sm font-semibold text-green-200 transition hover:border-green-300 hover:bg-green-500/20 hover:text-white">
                                <i class="fa-solid fa-file-pdf"></i>
                                View Resume
                            </a>
                        }
                    </div>

                    <nav class="mt-8 flex flex-col gap-3">
                        @foreach (var aboutSection in Model.Sections)
                        {
                            <a href="#@aboutSection.AnchorId" class="about-nav-link" data-index="@aboutSection.NavigationIndex">
                                @aboutSection.NavigationLabel
                            </a>
                        }
                    </nav>

                </div>

            </div>

        </aside>

        <!-- Right content panel -->
        <div id="about-content-panel" class="about-scrollbar about-content-panel relative z-20 px-6 py-12 sm:px-10 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:px-16 lg:py-20">

            @foreach (var aboutSection in Model.Sections)
            {
                <section id="@aboutSection.AnchorId"
                         class="flex min-h-[70vh] scroll-mt-8 flex-col justify-center @(aboutSection.HasDividerAfter ? "border-b border-white/10" : "") py-16">

                    <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                        // @aboutSection.NavigationLabel
                    </p>

                    <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
                        @aboutSection.Heading
                    </h2>

                    <div class="about-markdown mt-6 max-w-3xl text-lg leading-8 text-white/65 [&_a]:text-[#6ef967] [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:border-l [&_blockquote]:border-[#22ee29]/30 [&_blockquote]:pl-4 [&_code]:text-[#6ef967] [&_li]:mt-2 [&_p+p]:mt-4 [&_strong]:text-zinc-100 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
                        @Html.Raw(aboutSection.HtmlContent)
                    </div>

                </section>

                @if (aboutSection.HasDividerAfter)
                {
                    <div class="tech-divider" aria-hidden="true"></div>
                }
            }

        </div>

    </div>
</section>

<script>
    const aboutContentPanel = document.getElementById("about-content-panel");

    document.querySelectorAll(".about-nav-link").forEach(link => {
        link.addEventListener("click", event => {
            const targetId = link.getAttribute("href");

            if (!targetId || !targetId.startsWith("#")) {
                return;
            }

            const target = document.querySelector(targetId);

            if (!target) {
                return;
            }

            event.preventDefault();

            if (aboutContentPanel && window.matchMedia("(min-width: 1024px)").matches) {
                aboutContentPanel.scrollTo({
                    top: target.offsetTop,
                    behavior: "smooth"
                });
            }
            else {
                window.scrollTo({
                    top: target.getBoundingClientRect().top + window.scrollY,
                    behavior: "smooth"
                });
            }

            history.replaceState(null, "", targetId);
        });
    });
</script>