@{
    ViewData["Title"] = "About Me";
    ViewData["UseFixedViewport"] = true;
}

<section class="tech-surface bg-base-200 lg:h-full lg:overflow-hidden">
    <div class="mx-auto grid max-w-[1600px] lg:h-full lg:grid-cols-[minmax(18rem,34%)_minmax(0,1fr)]">

        <!-- Left navigation panel -->
        <aside class="about-profile-panel px-6 py-12 lg:h-full lg:px-10">
            <div class="flex h-full flex-col justify-center">

                <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                    // About Me
                </p>

                <h1 class="mt-4 text-4xl font-bold text-white">
                    Michael McNiel
                </h1>

                <p class="mt-4 max-w-md leading-7 text-white/60">
                    Software developer, technology enthusiast, and lifelong learner.
                </p>

                <nav class="mt-10 flex flex-col gap-3">
                    <a href="#introduction" class="about-nav-link" data-index="01">
                        Introduction
                    </a>

                    <a href="#experience" class="about-nav-link" data-index="02">
                        Experience
                    </a>

                    <a href="#education" class="about-nav-link" data-index="03">
                        Education
                    </a>

                    <a href="#interests" class="about-nav-link" data-index="04">
                        Interests
                    </a>
                </nav>

            </div>
        </aside>

        <!-- Right content panel -->
        <div class="about-scrollbar about-content-panel px-6 py-12 sm:px-10 lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:px-16 lg:py-20">

            <section id="introduction"
                     class="flex min-h-[70vh] scroll-mt-8 flex-col justify-center border-b border-white/10 py-16">

                <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                    // Introduction
                </p>

                <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
                    A little bit about me
                </h2>

                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/65">
                    This is temporary introduction content. We will replace it
                    with the final About page content after the layout is working.
                </p>

            </section>

            <div class="tech-divider" aria-hidden="true"></div>

            <section id="experience" class="flex min-h-[70vh] scroll-mt-8 flex-col justify-center border-b border-white/10 py-16">

                <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                    // Experience
                </p>

                <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
                    Professional experience
                </h2>

                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/65">
                    This section will eventually contain information about your
                    professional development experience and the systems you have built.
                </p>

            </section>

            <div class="tech-divider" aria-hidden="true"></div>

            <section id="education"
                     class="flex min-h-[70vh] scroll-mt-8 flex-col justify-center border-b border-white/10 py-16">

                <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                    // Education
                </p>

                <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
                    Education and learning
                </h2>

                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/65">
                    This section will contain your formal education, certifications,
                    and the subjects you are currently studying.
                </p>

            </section>

            <div class="tech-divider" aria-hidden="true"></div>

            <section id="interests"
                     class="flex min-h-[70vh] scroll-mt-8 flex-col justify-center py-16">

                <p class="font-tech text-neon-green text-sm font-semibold uppercase tracking-[0.35em]">
                    // Interests
                </p>

                <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
                    Beyond software development
                </h2>

                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/65">
                    This section will eventually describe your interests in hardware,
                    game consoles, home labs, low-level programming, and related topics.
                </p>

            </section>

        </div>

    </div>
</section>