@model mcnylo.dev.Admin.ViewModels.MFA.AdminMfaSetupVM

@{
    ViewData["Title"] = "Admin MFA Setup";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        <header class="mb-8">
            <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                // Admin MFA
            </p>

            <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                Multi-Factor Authentication
            </h1>

            <p class="mt-4 max-w-2xl text-base text-white/60">
                Add this admin account to an authenticator app, then enter the 6-digit code to enable MFA.
            </p>
        </header>

        <div class="border border-[#22ee29]/15 bg-black/25 p-5">
            @if (Model.IsEnabled)
            {
                <p class="border border-[#22ee29]/20 bg-[#22ee29]/[0.06] px-4 py-3 font-mono text-xs uppercase tracking-[0.14em] text-[#6ef967]">
                    MFA is enabled for the admin account.
                </p>

                <a href="/admin"
                   class="mt-6 inline-flex min-h-10 items-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                    Back to Admin
                </a>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <p class="mb-4 border border-red-500/30 bg-red-950/30 px-4 py-3 font-mono text-xs uppercase tracking-[0.14em] text-red-300">
                        @Model.ErrorMessage
                    </p>
                }

                <div class="space-y-5">

                    @if (!string.IsNullOrWhiteSpace(Model.QrCodeImageDataUrl))
                    {
                        <div>
                            <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                                Scan QR Code
                            </p>

                            <div class="mt-2 inline-block border border-[#22ee29]/15 bg-white p-3">
                                <img src="@Model.QrCodeImageDataUrl"
                                     alt="Authenticator app QR code"
                                     class="h-56 w-56" />
                            </div>
                        </div>
                    }

                    <div>
                        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                            Manual Setup Key
                        </p>
                        <p class="mt-2 break-all border border-[#22ee29]/15 bg-zinc-950/70 px-4 py-3 font-mono text-sm tracking-[0.12em] text-zinc-100">
                            @Model.ManualEntryKey
                        </p>
                    </div>

                    <div>
                        <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                            Authenticator URI
                        </p>
                        <p class="mt-2 break-all border border-[#22ee29]/15 bg-zinc-950/70 px-4 py-3 font-mono text-xs text-zinc-400">
                            @Model.AuthenticatorUri
                        </p>
                    </div>

                    <form method="post" action="/admin/mfa/setup" class="pt-2">
                        @Html.AntiForgeryToken()

                        <label asp-for="VerificationCode" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                            Verification Code
                        </label>
                        <input asp-for="VerificationCode"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />

                        <button type="submit"
                                class="mt-6 min-h-11 w-full border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                            Enable MFA
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</section>