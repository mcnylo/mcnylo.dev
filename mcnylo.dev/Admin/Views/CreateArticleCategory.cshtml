@model mcnylo.dev.Admin.ViewModels.Articles.AdminArticleCategoryFormVM

@{
    ViewData["Title"] = "Create Article Category";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        <header class="mb-10 flex flex-col gap-4 border-b border-[#22ee29]/15 pb-8 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                    // Admin / Articles / Categories
                </p>

                <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                    Create Category
                </h1>

                <p class="mt-4 max-w-2xl text-base text-white/60">
                    Add a category for organizing article archives.
                </p>
            </div>

            <a href="/admin/article-categories"
               class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                Cancel
            </a>
        </header>

        <form method="post" action="/admin/article-categories/create" class="border border-[#22ee29]/15 bg-black/25 p-5 sm:p-6">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="CategoryName" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                    Category Name
                </label>
                <input asp-for="CategoryName"
                       class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                <span asp-validation-for="CategoryName" class="mt-2 block text-sm text-red-300"></span>
            </div>

            <div class="mt-5">
                <label asp-for="CategorySlug" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                    Category Slug
                </label>
                <input asp-for="CategorySlug"
                       placeholder="build-log"
                       class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                <span asp-validation-for="CategorySlug" class="mt-2 block text-sm text-red-300"></span>
            </div>

            <div class="mt-5">
                <label asp-for="DisplayOrder" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                    Display Order
                </label>
                <input asp-for="DisplayOrder"
                       type="number"
                       class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                <span asp-validation-for="DisplayOrder" class="mt-2 block text-sm text-red-300"></span>
            </div>

            <button type="submit"
                    class="mt-6 min-h-11 border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                Create Category
            </button>
        </form>
    </div>
</section>