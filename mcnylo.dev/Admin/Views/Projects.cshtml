@model mcnylo.dev.Admin.ViewModels.Projects.AdminProjectListVM

@{
    ViewData["Title"] = "Admin Projects";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">

        <a href="/admin" class="text-sm font-mono uppercase tracking-[0.2em] text-emerald-400/70 hover:text-[#6ef967]">
            ← Back
        </a>

        <header class="mb-10 flex flex-col gap-4 border-b border-[#22ee29]/15 py-8 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                    // Admin / Projects
                </p>

                <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                    Project Control
                </h1>

                <p class="mt-4 max-w-2xl text-base text-white/60">
                    Review all project records before adding create, edit, and delete controls.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                <a href="/admin/tags?returnUrl=/admin/projects"
                   class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                    Tags
                </a>

                <a href="/admin/project-categories?returnUrl=/admin/projects"
                   class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                    Categories
                </a>

                <a href="/admin/projects/create"
                   class="inline-flex min-h-10 items-center justify-center border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-4 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                    New Project
                </a>
            </div>
        </header>

        <form method="get" action="/admin/projects" class="mb-10 border border-[#22ee29]/15 bg-black/25 p-4">
            <input type="hidden" name="pageNumber" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />

            <label for="admin-project-search" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                Search projects
            </label>

            <div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[minmax(0,1fr)_auto_auto]">
                <input id="admin-project-search"
                       name="search"
                       value="@Model.Search"
                       type="search"
                       placeholder="Search by title or slug..."
                       class="min-h-11 border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />

                <button type="submit"
                        class="min-h-11 border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                    Search
                </button>

                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a href="/admin/projects"
                       class="inline-flex min-h-11 items-center justify-center border border-zinc-700/80 px-5 font-mono text-xs uppercase tracking-[0.18em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200 sm:col-span-2 lg:col-span-1">
                        Clear
                    </a>
                }
            </div>

            <p class="mt-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-500">
                @Model.TotalProjects project@(Model.TotalProjects == 1 ? "" : "s") found
            </p>
        </form>

        @if (Model.Projects.Count == 0)
        {
            <div class="border-t border-[#22ee29]/15 py-12">
                <p class="font-mono text-sm uppercase tracking-[0.2em] text-zinc-500">
                    No projects found.
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto border border-[#22ee29]/15 bg-black/25">
                <table class="w-full min-w-[64rem] text-left">
                    <thead class="border-b border-[#22ee29]/15">
                        <tr>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Project</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Category</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Featured</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Tags</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Media</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Created</th>
                            <th class="px-4 py-3 font-mono text-xs uppercase tracking-[0.16em] text-[#6ef967]/70">Updated</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-[#22ee29]/10">
                        @foreach (var project in Model.Projects)
                        {
                            <tr class="transition hover:bg-[#22ee29]/[0.035]">
                                <td class="px-4 py-4">
                                    <p class="font-semibold text-zinc-100">@project.ProjectTitle</p>
                                    <p class="mt-1 font-mono text-xs text-zinc-500">@project.ProjectSlug</p>
                                </td>

                                <td class="px-4 py-4 font-mono text-xs uppercase tracking-[0.14em] text-zinc-400">
                                    @(string.IsNullOrWhiteSpace(project.CategoryName) ? "None" : project.CategoryName)
                                </td>

                                <td class="px-4 py-4">
                                    @if (project.IsFeatured)
                                    {
                                        <span class="inline-flex border border-[#22ee29]/25 bg-[#22ee29]/[0.07] px-2 py-1 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-[#6ef967]">
                                            Featured
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex border border-zinc-700/80 bg-zinc-950/60 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-zinc-400">
                                            Standard
                                        </span>
                                    }
                                </td>

                                <td class="px-4 py-4 font-mono text-xs text-zinc-500">
                                    @project.TagCount
                                </td>

                                <td class="px-4 py-4 font-mono text-xs text-zinc-500">
                                    @project.MediaCount
                                </td>

                                <td class="px-4 py-4 font-mono text-xs text-zinc-500">
                                    @project.CreatedOn.ToString("MMM dd, yyyy")
                                </td>

                                <td class="px-4 py-4 font-mono text-xs text-zinc-500">
                                    @(project.UpdatedOn.HasValue ? project.UpdatedOn.Value.ToString("MMM dd, yyyy") : "-")
                                </td>

                                <td class="px-4 py-4 text-right">
                                    <div class="flex justify-end gap-4">
                                        <a href="/projects/@project.ProjectSlug"
                                           target="_blank"
                                           class="font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:text-[#6ef967]">
                                            View
                                        </a>

                                        <span class="font-mono text-xs uppercase tracking-[0.16em] text-zinc-600">
                                            Actions soon
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-10 flex flex-col gap-3 border-t border-[#22ee29]/15 pt-6 sm:flex-row sm:items-center sm:justify-between"
                     aria-label="Admin project pagination">
                    <p class="font-mono text-xs uppercase tracking-[0.18em] text-zinc-500">
                        Page @Model.PageNumber of @Model.TotalPages
                    </p>

                    <div class="flex flex-wrap gap-2">
                        @if (Model.PageNumber > 1)
                        {
                            <a href="@BuildAdminProjectPageUrl(Model.PageNumber - 1)"
                               class="inline-flex min-h-10 items-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                                Prev
                            </a>
                        }

                        @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                        {
                            <a href="@BuildAdminProjectPageUrl(pageIndex)"
                               class="inline-flex min-h-10 min-w-10 items-center justify-center border px-3 font-mono text-xs uppercase tracking-[0.16em] transition @(pageIndex == Model.PageNumber ? "border-[#22ee29]/60 bg-[#22ee29]/[0.08] text-[#6ef967]" : "border-zinc-700/80 text-zinc-400 hover:border-[#22ee29]/35 hover:text-zinc-200")">
                                @pageIndex
                            </a>
                        }

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a href="@BuildAdminProjectPageUrl(Model.PageNumber + 1)"
                               class="inline-flex min-h-10 items-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                                Next
                            </a>
                        }
                    </div>
                </nav>
            }
        }
    </div>
</section>

@functions {
    private string BuildAdminProjectPageUrl(int pageNumber)
    {
        var queryValues = new List<string>
        {
            $"pageNumber={pageNumber}",
            $"pageSize={Model.PageSize}"
        };

        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            queryValues.Add($"search={Uri.EscapeDataString(Model.Search)}");
        }

        return $"/admin/projects?{string.Join("&", queryValues)}";
    }
}