@model mcnylo.dev.Admin.ViewModels.Media.AdminMediaDeleteVM

@{
    ViewData["Title"] = "Delete Media";

    var pageNumber = ViewData["PageNumber"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 10;
    var backUrl = $"/admin/media?pageNumber={pageNumber}&pageSize={pageSize}";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
        <header class="mb-10 flex flex-col gap-4 border-b border-[#22ee29]/15 pb-8 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                    // Admin / Media
                </p>

                <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                    Delete Media
                </h1>

                <p class="mt-4 max-w-2xl text-base text-white/60">
                    Review this file before deleting it from media storage.
                </p>
            </div>

            <a href="@backUrl"
               class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                Cancel
            </a>
        </header>

        <div class="grid gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]">
            <div class="border border-[#22ee29]/15 bg-black/25 p-4">
                <img src="@Model.RequestPath"
                     alt="@Model.FileName"
                     class="aspect-square w-full border border-[#22ee29]/15 object-cover opacity-85" />
            </div>

            <div class="space-y-5">
                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        File
                    </p>

                    <p class="mt-3 break-all font-mono text-sm text-zinc-100">
                        @Model.FileName
                    </p>

                    <p class="mt-2 break-all font-mono text-xs text-zinc-500">
                        @Model.RequestPath
                    </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-3">
                    <div class="border border-[#22ee29]/15 bg-black/25 p-4">
                        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967]/65">
                            Area
                        </p>
                        <p class="mt-2 font-mono text-sm text-zinc-100">
                            @Model.MediaArea
                        </p>
                    </div>

                    <div class="border border-[#22ee29]/15 bg-black/25 p-4">
                        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967]/65">
                            Size
                        </p>
                        <p class="mt-2 font-mono text-sm text-zinc-100">
                            @FormatFileSize(Model.FileSizeInBytes)
                        </p>
                    </div>

                    <div class="border border-[#22ee29]/15 bg-black/25 p-4">
                        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967]/65">
                            Modified
                        </p>
                        <p class="mt-2 font-mono text-sm text-zinc-100">
                            @Model.LastModifiedOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                    </div>
                </div>

                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        References
                    </p>

                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="border border-[#22ee29]/20 bg-[#22ee29]/[0.05] px-2 py-1 font-mono text-xs uppercase tracking-[0.12em] text-[#6ef967]">
                            Articles: @Model.ArticleReferenceCount
                        </span>

                        <span class="border border-[#22ee29]/20 bg-[#22ee29]/[0.05] px-2 py-1 font-mono text-xs uppercase tracking-[0.12em] text-[#6ef967]">
                            Projects: @Model.ProjectReferenceCount
                        </span>
                    </div>

                    @if (Model.IsReferenced)
                    {
                        <p class="mt-4 text-sm leading-6 text-red-300">
                            This file is still referenced and should not be deleted yet.
                        </p>
                    }
                    else
                    {
                        <p class="mt-4 text-sm leading-6 text-zinc-400">
                            This file is not referenced by any articles or projects.
                        </p>
                    }
                </div>

                @if (Model.IsReferenced)
                {
                    <button type="button"
                            disabled
                            class="min-h-11 w-full border border-red-400/20 bg-red-400/[0.03] px-5 font-mono text-xs uppercase tracking-[0.18em] text-red-300/45">
                        Still Referenced
                    </button>
                }
                else
                {
                    <form method="post" action="/admin/media/delete">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="relativePath" value="@Model.RelativePath" />
                        <input type="hidden" name="pageNumber" value="@pageNumber" />
                        <input type="hidden" name="pageSize" value="@pageSize" />

                        <button type="submit"
                                class="min-h-11 w-full border border-red-400/35 bg-red-400/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-red-300 transition hover:border-red-300/60 hover:bg-red-400/[0.1]">
                            Delete Media
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@functions {
    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.##} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.##} KB";
        }

        return $"{bytes} B";
    }
}