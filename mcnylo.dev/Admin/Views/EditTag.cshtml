@model mcnylo.dev.Admin.ViewModels.Tags.AdminTagFormVM

@{
    ViewData["Title"] = "Edit Global Tag";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        <header class="mb-10 flex flex-col gap-4 border-b border-[#22ee29]/15 pb-8 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                    // Admin / Global Tags
                </p>

                <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                    Edit Tag
                </h1>

                <p class="mt-4 max-w-2xl text-base text-white/60">
                    Edit tag shared by articles and projects.
                </p>
            </div>

            <a href="@Model.ReturnUrl"
               class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                Back
            </a>
        </header>

        <form method="post" action="/admin/tags/@Model.Id/edit" class="border border-[#22ee29]/15 bg-black/25 p-5 sm:p-6">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="TagName" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                    Tag Name
                </label>
                <input asp-for="TagName"
                       class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                <span asp-validation-for="TagName" class="mt-2 block text-sm text-red-300"></span>
            </div>

            <div class="mt-5">
                <label asp-for="TagSlug" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                    Tag Slug
                </label>
                <input asp-for="TagSlug"
                       placeholder="asp-net-core"
                       class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                <span asp-validation-for="TagSlug" class="mt-2 block text-sm text-red-300"></span>
            </div>

            <button type="submit"
                    class="mt-6 min-h-11 border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                Save Tag
            </button>
        </form>
    </div>
</section>