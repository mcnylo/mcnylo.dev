@model mcnylo.dev.Admin.ViewModels.About.AdminAboutFormVM

@{
    ViewData["Title"] = "Edit About";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">

        <a href="/admin" class="text-sm font-mono uppercase tracking-[0.2em] text-emerald-400/70 hover:text-[#6ef967]">
            ← Back
        </a>

        <header class="mb-10 flex flex-col gap-4 border-b border-[#22ee29]/15 py-8 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                    // Admin / About
                </p>

                <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                    About Control
                </h1>

                <p class="mt-4 max-w-2xl text-base text-white/60">
                    Review the content currently loaded for the About page.
                </p>
            </div>

        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="mb-6 border border-[#22ee29]/25 bg-[#22ee29]/[0.06] px-4 py-5 font-mono text-xs uppercase tracking-[0.14em] text-[#6ef967]">
                @successMessage
            </div>
        }

        <form method="post" action="/admin/about">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="space-y-5">
                <div>
                    <label asp-for="DisplayName" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Display Name
                    </label>
                    <input asp-for="DisplayName"
                           class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                    <span asp-validation-for="DisplayName" class="mt-2 block text-sm text-red-300"></span>
                </div>

                <div>
                    <label asp-for="ProfileSummary" class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Profile Summary
                    </label>
                    <textarea asp-for="ProfileSummary"
                              rows="3"
                              class="mt-2 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 py-3 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30"></textarea>
                    <span asp-validation-for="ProfileSummary" class="mt-2 block text-sm text-red-300"></span>
                </div>

                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Introduction
                    </p>

                    <label asp-for="IntroductionHeading" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Heading
                    </label>
                    <input asp-for="IntroductionHeading"
                           class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                    <span asp-validation-for="IntroductionHeading" class="mt-2 block text-sm text-red-300"></span>

                    <label asp-for="IntroductionMarkdown" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Markdown
                    </label>
                    <textarea asp-for="IntroductionMarkdown"
                              rows="8"
                              class="mt-2 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 py-3 font-mono text-sm leading-6 text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30"></textarea>
                    <span asp-validation-for="IntroductionMarkdown" class="mt-2 block text-sm text-red-300"></span>
                </div>

                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Experience
                    </p>

                    <label asp-for="ExperienceHeading" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Heading
                    </label>
                    <input asp-for="ExperienceHeading"
                           class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                    <span asp-validation-for="ExperienceHeading" class="mt-2 block text-sm text-red-300"></span>

                    <label asp-for="ExperienceMarkdown" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Markdown
                    </label>
                    <textarea asp-for="ExperienceMarkdown"
                              rows="8"
                              class="mt-2 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 py-3 font-mono text-sm leading-6 text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30"></textarea>
                    <span asp-validation-for="ExperienceMarkdown" class="mt-2 block text-sm text-red-300"></span>
                </div>

                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Education
                    </p>

                    <label asp-for="EducationHeading" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Heading
                    </label>
                    <input asp-for="EducationHeading"
                           class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                    <span asp-validation-for="EducationHeading" class="mt-2 block text-sm text-red-300"></span>

                    <label asp-for="EducationMarkdown" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Markdown
                    </label>
                    <textarea asp-for="EducationMarkdown"
                              rows="8"
                              class="mt-2 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 py-3 font-mono text-sm leading-6 text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30"></textarea>
                    <span asp-validation-for="EducationMarkdown" class="mt-2 block text-sm text-red-300"></span>
                </div>

                <div class="border border-[#22ee29]/15 bg-black/25 p-5">
                    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[#6ef967]/65">
                        Interests
                    </p>

                    <label asp-for="InterestsHeading" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Heading
                    </label>
                    <input asp-for="InterestsHeading"
                           class="mt-2 min-h-11 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 font-mono text-sm text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30" />
                    <span asp-validation-for="InterestsHeading" class="mt-2 block text-sm text-red-300"></span>

                    <label asp-for="InterestsMarkdown" class="mt-4 block font-mono text-xs uppercase tracking-[0.18em] text-zinc-400">
                        Markdown
                    </label>
                    <textarea asp-for="InterestsMarkdown"
                              rows="8"
                              class="mt-2 w-full border border-[#22ee29]/20 bg-zinc-950/70 px-4 py-3 font-mono text-sm leading-6 text-zinc-100 outline-none transition focus:border-[#22ee29]/60 focus:ring-1 focus:ring-[#22ee29]/30"></textarea>
                    <span asp-validation-for="InterestsMarkdown" class="mt-2 block text-sm text-red-300"></span>
                </div>
            </div>

            <br/>

            <div>

                <button type="submit"
                        class="min-h-11 w-full border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                    Save About
                </button>

            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}