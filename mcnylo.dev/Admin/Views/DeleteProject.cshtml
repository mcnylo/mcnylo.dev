@model mcnylo.dev.Admin.ViewModels.Projects.AdminProjectDeleteVM

@{
    ViewData["Title"] = "Delete Project";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        <a href="/admin/projects"
           class="text-sm font-mono uppercase tracking-[0.2em] text-emerald-400/70 hover:text-[#6ef967]">
            ← Projects
        </a>

        <div class="mt-8 border border-red-500/25 bg-red-950/20 p-6">
            <p class="font-mono text-xs uppercase tracking-[0.25em] text-red-300/80">
                Confirm Delete
            </p>

            <h1 class="mt-3 text-3xl font-bold text-white">
                Delete @Model.ProjectTitle?
            </h1>

            <p class="mt-4 text-sm leading-7 text-zinc-400">
                This will remove the project record, its tag connections, and its media records from the database.
                Uploaded image files will remain on disk for now.
            </p>

            <dl class="mt-6 grid gap-3 border-t border-red-500/20 pt-6 font-mono text-xs uppercase tracking-[0.14em] text-zinc-400 sm:grid-cols-2">
                <div>
                    <dt class="text-zinc-600">Slug</dt>
                    <dd class="mt-1 text-zinc-200">@Model.ProjectSlug</dd>
                </div>

                <div>
                    <dt class="text-zinc-600">Category</dt>
                    <dd class="mt-1 text-zinc-200">@Model.CategoryName</dd>
                </div>

                <div>
                    <dt class="text-zinc-600">Tags</dt>
                    <dd class="mt-1 text-zinc-200">@Model.TagCount</dd>
                </div>

                <div>
                    <dt class="text-zinc-600">Media Items</dt>
                    <dd class="mt-1 text-zinc-200">@Model.MediaCount</dd>
                </div>
            </dl>

            <form method="post" action="/admin/projects/@Model.Id/delete" class="mt-8 flex flex-wrap gap-3">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="inline-flex min-h-10 items-center justify-center border border-red-400/50 bg-red-500/10 px-4 font-mono text-xs uppercase tracking-[0.16em] text-red-200 transition hover:border-red-300 hover:bg-red-500/20">
                    Delete Project
                </button>

                <a href="/admin/projects"
                   class="inline-flex min-h-10 items-center justify-center border border-zinc-700/80 px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</section>