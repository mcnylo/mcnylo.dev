@model mcnylo.dev.Admin.ViewModels.MFA.AdminMfaRecoveryCodesVM

@{
    ViewData["Title"] = "Admin MFA Recovery Codes";
}

<section class="archive-surface min-h-[calc(100svh-8rem)] bg-base-200 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
        <header class="mb-8">
            <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                // Admin MFA
            </p>

            <h1 class="mt-3 text-4xl font-bold text-white sm:text-5xl">
                Save Your Recovery Codes
            </h1>

            <p class="mt-4 max-w-2xl text-base text-white/60">
                These codes are shown once. Store them somewhere safe. Each code can be used one time if you lose access to your authenticator app.
            </p>
        </header>

        <div class="border border-[#22ee29]/15 bg-black/25 p-5">
            <div class="grid gap-3 sm:grid-cols-2">
                @foreach (var recoveryCode in Model.RecoveryCodes)
                {
                    <p class="border border-[#22ee29]/15 bg-zinc-950/70 px-4 py-3 font-mono text-sm tracking-[0.14em] text-zinc-100">
                        @recoveryCode
                    </p>
                }
            </div>

            <a href="/admin"
               class="mt-6 inline-flex min-h-10 items-center border border-[#22ee29]/30 bg-[#22ee29]/[0.06] px-5 font-mono text-xs uppercase tracking-[0.18em] text-[#6ef967] transition hover:border-[#6ef967]/60 hover:bg-[#22ee29]/[0.1]">
                I Saved These Codes
            </a>
        </div>
    </div>
</section>