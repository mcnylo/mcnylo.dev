@model mcnylo.dev.Projects.ViewModels.ProjectResultsVM

@if (!Model.Projects.Any())
{
    <div class="border-t border-[#22ee29]/15 py-12">
        <p class="font-mono text-sm uppercase tracking-[0.2em] text-zinc-500">
            No projects found.
        </p>
    </div>
}
else
{
    <div class="space-y-8">
        @foreach (var project in Model.Projects)
        {
            <article class="project-frame">
                <div class="project-frame-panel w-full overflow-hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-12">
                        <div class="lg:col-span-4">
                            <img src="@project.ProjectThumbnailURL"
                                 alt="@project.ProjectThumbnailAltText"
                                 class="aspect-video w-full object-cover lg:h-full lg:aspect-auto" />
                        </div>

                        <div class="card-body lg:col-span-8">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="badge badge-primary badge-outline">
                                    @project.ProjectCategory
                                </span>

                                @if (project.IsFeatured)
                                {
                                    <span class="badge badge-secondary">
                                        Featured
                                    </span>
                                }
                            </div>

                            <h2 class="card-title mt-2 text-3xl text-white">
                                @project.ProjectTitle
                            </h2>

                            <p class="max-w-3xl text-base leading-7 text-white/65">
                                @project.ProjectShortDescription
                            </p>

                            <div class="mt-4 flex flex-wrap gap-2">
                                @foreach (var tag in project.Tags)
                                {
                                    <span class="badge badge-primary badge-outline">
                                        @tag
                                    </span>
                                }
                            </div>

                            <div class="card-actions mt-auto justify-end pt-6">
                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-slug="@project.ProjectSlug"
                                   class="btn btn-primary">
                                    More Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-10 flex flex-col gap-3 border-t border-[#22ee29]/15 pt-6 sm:flex-row sm:items-center sm:justify-between"
             aria-label="Project pagination">
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-zinc-500">
                Page @Model.PageNumber of @Model.TotalPages
            </p>

            <div class="flex flex-wrap gap-2">
                @if (Model.HasPreviousPage)
                {
                    <button type="button"
                            class="inline-flex min-h-10 items-center border border-zinc-700/80 bg-transparent px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200"
                            data-project-page="@(Model.PageNumber - 1)">
                        Prev
                    </button>
                }

                @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                {
                    <button type="button"
                            class="inline-flex min-h-10 min-w-10 items-center justify-center border bg-transparent px-3 font-mono text-xs uppercase tracking-[0.16em] transition @(pageIndex == Model.PageNumber ? "border-[#22ee29]/60 bg-[#22ee29]/[0.08] text-[#6ef967]" : "border-zinc-700/80 text-zinc-400 hover:border-[#22ee29]/35 hover:text-zinc-200")"
                            data-project-page="@pageIndex">
                        @pageIndex
                    </button>
                }

                @if (Model.HasNextPage)
                {
                    <button type="button"
                            class="inline-flex min-h-10 items-center border border-zinc-700/80 bg-transparent px-4 font-mono text-xs uppercase tracking-[0.16em] text-zinc-400 transition hover:border-[#22ee29]/35 hover:text-zinc-200"
                            data-project-page="@(Model.PageNumber + 1)">
                        Next
                    </button>
                }
            </div>
        </nav>
    }
}