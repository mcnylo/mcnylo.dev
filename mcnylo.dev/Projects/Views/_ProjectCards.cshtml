@model mcnylo.dev.Projects.ViewModels.ProjectResultsVM

@if (!Model.Projects.Any())
{
    <div class="border-t border-[#22ee29]/15 py-12">
        <p class="font-mono text-sm uppercase tracking-[0.2em] text-zinc-500">
            No projects found.
        </p>
    </div>
}
else
{
    <div class="space-y-8">
        @foreach (var project in Model.Projects)
        {
            <article class="project-frame">
                <div class="project-frame-panel w-full overflow-hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-12">
                        <div class="lg:col-span-4">
                            <img src="@project.ProjectThumbnailURL"
                                 alt="@project.ProjectThumbnailAltText"
                                 class="aspect-video w-full object-cover lg:h-full lg:aspect-auto" />
                        </div>

                        <div class="card-body lg:col-span-8">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="badge badge-primary badge-outline">
                                    @project.ProjectCategory
                                </span>

                                @if (project.IsFeatured)
                                {
                                    <span class="badge badge-secondary">
                                        Featured
                                    </span>
                                }
                            </div>

                            <h2 class="card-title mt-2 text-3xl text-white">
                                @project.ProjectTitle
                            </h2>

                            <p class="max-w-3xl text-base leading-7 text-white/65">
                                @project.ProjectShortDescription
                            </p>

                            <div class="mt-4 flex flex-wrap gap-2">
                                @foreach (var tag in project.Tags)
                                {
                                    <span class="badge badge-primary badge-outline">
                                        @tag
                                    </span>
                                }
                            </div>

                            <div class="card-actions mt-auto justify-end pt-6">
                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-slug="@project.ProjectSlug"
                                   class="btn btn-primary">
                                    More Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="mt-10 flex flex-col items-center justify-between gap-4 rounded-box border border-white/10 bg-base-300/50 p-4 sm:flex-row">
            <p class="text-sm text-white/60">
                Showing page @Model.PageNumber of @Model.TotalPages
                <span class="text-white/40">(@Model.TotalProjects projects)</span>
            </p>

            <div class="join">
                <button type="button"
                        class="btn join-item btn-sm @(Model.HasPreviousPage ? "" : "btn-disabled")"
                        data-project-page="@(Model.PageNumber - 1)">
                    Previous
                </button>

                @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <button type="button"
                            class="btn join-item btn-sm @(pageNumber == Model.PageNumber ? "btn-primary" : "")"
                            data-project-page="@pageNumber">
                        @pageNumber
                    </button>
                }

                <button type="button"
                        class="btn join-item btn-sm @(Model.HasNextPage ? "" : "btn-disabled")"
                        data-project-page="@(Model.PageNumber + 1)">
                    Next
                </button>
            </div>
        </div>
    }
}