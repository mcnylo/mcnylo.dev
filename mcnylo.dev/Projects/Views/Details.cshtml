@model mcnylo.dev.Projects.ViewModels.ProjectDetailsVM

@{
    ViewData["Title"] = Model.ProjectTitle;
    ViewData["MainClass"] = "archive-surface bg-base-200";
}

<section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">
        <div class="mb-8">
            <a href="/projects"
               class="text-sm font-mono uppercase tracking-[0.2em] text-emerald-400/70 hover:text-[#6ef967]">
                ← Projects
            </a>
        </div>

        <div class="mb-10">
            <p class="font-tech text-sm font-semibold uppercase tracking-[0.35em] text-neon-green">
                // Project Details
            </p>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <span class="badge badge-primary badge-outline">
                    @Model.ProjectCategory
                </span>

                @if (Model.IsFeatured)
                {
                    <span class="badge badge-secondary">
                        Featured
                    </span>
                }
            </div>

            <h1 class="mt-4 text-4xl font-bold text-white sm:text-5xl">
                @Model.ProjectTitle
            </h1>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
            <div class="lg:col-span-8">
                @if (Model.MediaItems.Any())
                {
                    <div id="project-media-carousel" class="detail-media-panel h-full">
                        <div class="detail-media-panel-inner h-full">
                            <div class="card-body">
                                <h2 class="detail-panel-title mb-4 text-2xl font-bold text-white">
                                    Media
                                </h2>

                                <div class="group relative overflow-hidden rounded-box border border-white/10 bg-black">
                                    <div id="project-media-display"
                                         class="transition-opacity duration-300 ease-out">
                                    </div>

                                    @if (Model.MediaItems.Count > 1)
                                    {
                                        <button type="button"
                                                data-project-media-previous
                                                aria-label="Previous media"
                                                class="absolute left-3 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-[#22ee29]/30 bg-black/70 text-sm text-[#6ef967] opacity-0 transition hover:border-[#6ef967]/60 hover:bg-black/90 group-hover:opacity-100 focus-visible:opacity-100">
                                            <i class="fa-solid fa-chevron-left"></i>
                                        </button>

                                        <button type="button"
                                                data-project-media-next
                                                aria-label="Next media"
                                                class="absolute right-3 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-[#22ee29]/30 bg-black/70 text-sm text-[#6ef967] opacity-0 transition hover:border-[#6ef967]/60 hover:bg-black/90 group-hover:opacity-100 focus-visible:opacity-100">
                                            <i class="fa-solid fa-chevron-right"></i>
                                        </button>
                                    }
                                </div>

                                <div class="media-scrollbar mt-4 flex gap-3 overflow-x-auto pb-2">
                                    @foreach (var mediaItem in Model.MediaItems)
                                    {
                                        string thumbnailURL = BuildMediaThumbnailUrl(mediaItem);

                                        <button type="button"
                                                class="relative w-36 shrink-0 overflow-hidden rounded-box border border-white/10 bg-base-300 opacity-70 transition hover:opacity-100 aria-selected:border-primary aria-selected:opacity-100"
                                                data-project-media-button
                                                data-media-type="@mediaItem.MediaType"
                                                data-media-url="@mediaItem.MediaURL"
                                                data-thumbnail-url="@thumbnailURL"
                                                data-alt-text="@mediaItem.AltText"
                                                data-is-primary="@mediaItem.IsPrimary.ToString().ToLowerInvariant()"
                                                aria-selected="false">

                                            <img src="@thumbnailURL"
                                                 alt="@mediaItem.AltText"
                                                 class="aspect-video w-full object-cover" />

                                            @if (mediaItem.IsVideo)
                                            {
                                                <span class="absolute inset-0 flex items-center justify-center bg-black/35">
                                                    <i class="fa-solid fa-play"></i>
                                                </span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card card-glass h-full border border-white/15">
                        <div class="card-body">
                            <h2 class="text-2xl font-bold text-white">
                                Media
                            </h2>

                            <div class="mt-4 flex aspect-video items-center justify-center rounded-box border border-white/10 bg-black">
                                <p class="text-sm text-white/50 p-4">
                                    No media available for this project.
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <aside class="space-y-6 lg:col-span-4">

                <div class="detail-module">
                    <div class="detail-module-inner">
                        <div class="card-body">

                            <h2 class="text-xl font-bold text-white">
                                Links
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(Model.RepositoryURL))
                            {
                                <a href="@Model.RepositoryURL"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn btn-primary mt-4">
                                    <i class="fa-brands fa-github"></i>
                                    View Repository
                                </a>
                            }
                            else
                            {
                                <p class="mt-4 text-sm text-white/50">
                                    No public repository available for this project.
                                </p>
                            }

                        </div>
                    </div>
                </div>

                <div class="detail-module">
                    <div class="detail-module-inner">
                        <div class="card-body">

                            <h2 class="detail-module-title text-xl font-bold text-white">
                                Technologies
                            </h2>

                            <div class="mt-4 flex flex-wrap gap-2">
                                @foreach (var tag in Model.Tags)
                                {
                                    <span class="badge badge-primary badge-outline">
                                        @tag
                                    </span>
                                }
                            </div>

                        </div>
                    </div>
                </div>

            </aside>
        </div>

        <article class="detail-readout mt-8">
            <div class="detail-readout-inner">
                <div class="card-body gap-0">

                    <h2 class="detail-readout-title text-2xl font-bold text-white">
                        About this project
                    </h2>

                    <p class="mt-3 whitespace-pre-line text-base leading-8 text-white/65">
                        @Model.ProjectDescription.Trim()
                    </p>

                </div>
            </div>
        </article>

    </div>
</section>

<script src="~/js/project-details.js" asp-append-version="true"></script>

@functions {
    private static string BuildMediaThumbnailUrl(mcnylo.dev.Projects.ViewModels.ProjectMediaVM mediaItem)
    {
        if (!string.IsNullOrWhiteSpace(mediaItem.ThumbnailURL))
        {
            return mediaItem.ThumbnailURL;
        }

        if (mediaItem.IsImage)
        {
            return mediaItem.MediaURL;
        }

        if (TryGetYouTubeVideoId(mediaItem.MediaURL, out var videoId))
        {
            return $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";
        }

        return "/images/thumb-placeholder.jpg";
    }

    private static bool TryGetYouTubeVideoId(string mediaUrl, out string videoId)
    {
        videoId = "";

        if (!Uri.TryCreate(mediaUrl, UriKind.Absolute, out var uri))
        {
            return false;
        }

        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var embedIndex = Array.FindIndex(segments, segment => segment.Equals("embed", StringComparison.OrdinalIgnoreCase));

        if (embedIndex < 0 || embedIndex + 1 >= segments.Length)
        {
            return false;
        }

        videoId = segments[embedIndex + 1];

        return true;
    }
}