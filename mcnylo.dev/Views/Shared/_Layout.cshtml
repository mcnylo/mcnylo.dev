<!DOCTYPE html>
<html lang="en" class="bg-zinc-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - McNylo</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body class="min-h-screen flex flex-col">

    <header>
        <nav class="navbar justify-between sm:justify-evenly bg-base-300">
            <!-- Logo -->
            <a class="text-lg order-2 sm:order-none pr-2 sm:pr-0" asp-controller="Home" asp-action="Index">
                <img alt="McNylo.dev Logo" src="~/images/mcnylo_logo_white.png" class="w-20" />
            </a>

            <!-- Menu for mobile -->
            <div class="dropdown dropdown-start order-1 sm:hidden">
                <button class="btn btn-ghost">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>

                <ul tabindex="0" class="dropdown-content menu z-[1] bg-base-200 p-6 rounded-box shadow w-56 gap-2">
                    <div class="flex justify-center gap-2">
                        <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://github.com/mcnylo" target="_blank">
                            <i class="fa-brands fa-fw fa-github"></i>
                        </a>

                        <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.linkedin.com/in/michaelmcniel65/" target="_blank">
                            <i class="fa-brands fa-fw fa-linkedin"></i>
                        </a>
                    </div>

                    <li><a asp-controller="About" asp-action="Index">About Me</a></li>
                    <li><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                </ul>
            </div>

            <!-- Menu for desktop -->
            <ul class="menu hidden gap-2 sm:flex sm:menu-horizontal">
                <li><a asp-controller="About" asp-action="Index">About Me</a></li>
                <li><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
            </ul>

            <div class="hidden sm:flex gap-2">
                <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://github.com/mcnylo" target="_blank">
                    <i class="fa-brands fa-fw fa-github"></i>
                </a>

                <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.linkedin.com/in/michaelmcniel65/" target="_blank">
                    <i class="fa-brands fa-fw fa-linkedin"></i>
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-1">
        @RenderBody()
    </main>

    <footer class="footer footer-center border-t border-base-300 bg-base-300 p-6 text-base-content/70">
        <aside>
            <p>&copy; @DateTime.Now.Year Michael McNiel (McNylo)</p>
        </aside>
    </footer>


    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
