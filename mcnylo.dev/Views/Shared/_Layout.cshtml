@{
    var useFixedViewport = ViewData["UseFixedViewport"] is true;
    var mainClass = ViewData["MainClass"] as string ?? "";
}

<!DOCTYPE html>
<html lang="en" class="bg-base-200" data-theme="mcnylodev-theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - McNylo</title>
    <script type="importmap"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col @(useFixedViewport ? "lg:h-screen lg:overflow-hidden" : "")">

    <header class="relative z-50 shrink-0">
        <nav class="navbar justify-between sm:justify-evenly bg-base-300">
            <!-- Logo -->
            <a class="text-lg order-2 sm:order-none pr-2 sm:pr-0" asp-controller="Home" asp-action="Index">
                <img alt="McNylo.dev Logo" src="~/images/mcnylodev_logo_white.png" class="w-40" />
            </a>

            <!-- Menu for mobile -->
            <div class="dropdown dropdown-start order-1 sm:hidden">
                <button class="btn btn-ghost">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>

                <ul tabindex="0" class="dropdown-content menu z-[1] bg-base-200 p-6 rounded-box shadow w-56 gap-2">
                    <div class="flex justify-center gap-2">
                        <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://github.com/mcnylo" target="_blank">
                            <i class="fa-brands fa-fw fa-github"></i>
                        </a>

                        <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.linkedin.com/in/michaelmcniel65/" target="_blank">
                            <i class="fa-brands fa-fw fa-linkedin"></i>
                        </a>

                        <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.youtube.com/@@McNyloLT" target="_blank">
                            <i class="fa-brands fa-fw fa-youtube"></i>
                        </a>
                    </div>

                    <li><a asp-controller="About" asp-action="Index">About Me</a></li>
                    <li><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                </ul>
            </div>

            <!-- Menu for desktop -->
            <ul class="menu hidden gap-2 sm:flex sm:menu-horizontal">
                <li><a asp-controller="About" asp-action="Index">About Me</a></li>
                <li><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                <li><a asp-controller="Articles" asp-action="Index">Articles</a></li>
            </ul>

            <div class="hidden sm:flex gap-2">
                <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://github.com/mcnylo" target="_blank">
                    <i class="fa-brands fa-fw fa-github"></i>
                </a>

                <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.linkedin.com/in/michaelmcniel65/" target="_blank">
                    <i class="fa-brands fa-fw fa-linkedin"></i>
                </a>

                <a class="btn btn-circle btn-ghost btn-sm text-xl" href="https://www.youtube.com/@@McNyloLT" target="_blank">
                    <i class="fa-brands fa-fw fa-youtube"></i>
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-1 @mainClass @(useFixedViewport ? "lg:min-h-0 lg:overflow-hidden" : "")">
        @RenderBody()
    </main>

    <div class="tech-divider" aria-hidden="true"></div>

    <footer class="footer footer-center shrink-0 border-t border-base-300 bg-base-300 p-6 text-base-content/70">
        <aside>
            <p>&copy; @DateTime.Now.Year Michael McNiel (McNylo)</p>
        </aside>
    </footer>


    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
